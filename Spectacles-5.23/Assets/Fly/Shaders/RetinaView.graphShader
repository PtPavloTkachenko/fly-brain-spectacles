    Node5:
      DependencyIndex: 5
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            // RetinaView - the little panel on the board that shows WHAT THE BRAIN SEES (12.09 Pavlo: "can we
            // show the fly-eye render target the way its brain sees it, in a small corner near the brain?").
            //
            // Not the camera image: the texture is built from FlyVision.retina(i), the same 16x8 RGB array that
            // is sent to the brain as its retina (mean brightness pinned, ADR 15). One texel per ommatidial
            // block, sampled NEAREST so the blocks stay blocks - that coarseness IS the honest part.
            //
            // `eye` carries the retina, `tint` is the selected fly's colour, `gain` lifts it for the additive
            // display, `grid` draws faint cell borders so it reads as a sensor, not a photo. ASCII only;
            // no input named `color` (the Spectacles cross-compiler rejects it).
            
            input_texture_2d eye;
            input_color4 tint;
            input_float gain;
            input_float grid;
            input_float cells;
            
            output_vec4 vertexColor;
            
            void main() {
                vec2 uv = system.getSurfaceUVCoord0();
                vec2 flipped = vec2(uv.x, 1.0 - uv.y); // LS flips V on import; the retina's first row is the top
                vec3 seen = eye.sample(flipped).rgb;
            
                // faint per-cell border: a thin dark line at each block edge
                float c = cells;
                if (c < 2.0) c = 2.0;
                vec2 f = fract(uv * vec2(c, c * 0.5));
                vec2 e = min(f, 1.0 - f);
                float line = 1.0 - smoothstep(0.0, 0.06, min(e.x, e.y));
            
                vec3 col = seen * gain * tint.rgb * (1.0 - grid * line);
                vertexColor = vec4(col, 1.0);
            }

        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Custom Code
        cells:
          Connection0:
            NodeLevelID: 6
            PortID: Output
          Variable: 0.0
        eye:
          ClassType1: LINK
          Connection0:
            NodeLevelID: 2
            PortID: Texture
          Property:
            Variables:
              {}
        gain:
          Connection0:
            NodeLevelID: 4
            PortID: Output
          Variable: 0.0
        grid:
          Connection0:
            NodeLevelID: 5
            PortID: Output
          Variable: 0.0
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        tint:
          ClassType1: COLOR
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 1.0]
        vertexColor:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: 0
