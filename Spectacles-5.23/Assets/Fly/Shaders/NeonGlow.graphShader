    Node5:
      DependencyIndex: 5
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            // Device-safe rename (11.09): the Spectacles cross-compiler rejects a uniform named `color`
            // ('color' : redefinition, no code generated) -> the input is `tint`. ASCII only.
            // NeonGlow - one shader for the status board bars/tabs, the glow under the selected fly
            // and its flight trail. Unit quad UVs: glowMode 0 = bar with soft top/bottom edges,
            // glowMode 1 = radial glow disc. fadeX fades along uv.x (trail tail). ASCII only.
            
            input_color4 tint;
            input_float intensity;
            input_float glowMode;
            input_float fadeX;
            input_float alpha;
            
            output_vec4 vertexColor;
            
            void main() {
                vec2 uv = system.getSurfaceUVCoord0();
                vec2 c = uv * 2.0 - 1.0;
                float radial = 1.0 - length(c);
                if (radial < 0.0) radial = 0.0;
                radial = radial * radial;
                float bar = smoothstep(0.0, 0.3, uv.y) * smoothstep(1.0, 0.7, uv.y);
                float shape = mix(bar, radial, glowMode);
                if (glowMode > 1.5) shape = 1.0;
                shape = shape * mix(1.0, uv.x, fadeX);
                vec3 col = tint.rgb * intensity * shape;
                vertexColor = vec4(col, shape * alpha);
            }

        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Custom Code
        alpha:
          Connection0:
            NodeLevelID: 6
            PortID: Output
          Variable: 0.0
        fadeX:
          Connection0:
            NodeLevelID: 5
            PortID: Output
          Variable: 0.0
        glowMode:
          Connection0:
            NodeLevelID: 4
            PortID: Output
          Variable: 0.0
        intensity:
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: 0.0
        ngs_Height:
          Variable: 400
        ngs_Version:
          String: 0.1.0
        tint:
          ClassType1: COLOR
          Connection0:
            NodeLevelID: 2
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 1.0]
        vertexColor:
          IOType: 1
          Variable: [0.0, 0.0, 0.0, 0.0]
      PositionX: 0
      PositionY: 0
      TemplateID: node_util_custom
      TemplateVersionMinor: 2
      Title1: Custom Code
